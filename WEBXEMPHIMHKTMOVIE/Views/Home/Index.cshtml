@model IEnumerable<WEBXEMPHIMHKTMOVIE.Models.Movie>
@{
    ViewBag.Title = "Trang chủ";
    var sliderMovies = ViewBag.SliderMovies as List<WEBXEMPHIMHKTMOVIE.Models.Movie>;
    var genres = ViewBag.Genres as List<WEBXEMPHIMHKTMOVIE.Models.Genre>;
    var featuredMovies = ViewBag.FeaturedMovies as List<WEBXEMPHIMHKTMOVIE.Models.Movie>;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}
@{
    bool isVip = Session["IsVip"] != null && (bool)Session["IsVip"];
}

<link rel="stylesheet" href="~/Content/css/home-index.css" />
<link rel="stylesheet" href="~/Content/css/addbanner.css" />
<link rel="stylesheet" href="~/Content/css/bannerpopup.css" />
<div class="page-index">
    <!-- Hiển thị thông báo lỗi nếu có -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["Error"]
        </div>
    }
    <div class="container mt-4">
        <!-- ========== SLIDER ========== -->
        <div id="movieSlider"
             class="carousel slide mb-5"
             data-bs-ride="carousel"
             data-bs-interval="2000"
             data-bs-pause="hover">

            <div class="carousel-inner">
                @for (int i = 0; i < sliderMovies.Count; i++)
                {
                    var movie = sliderMovies[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@Url.Content(movie.PosterPath)"
                             class="d-block w-100"
                             alt="@movie.Title"
                             style="height:600px; object-fit:cover;" />
                        <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3">
                            <h5>@movie.Title</h5>
                            <p>
                                @(string.IsNullOrEmpty(movie.Description)
                                ? ""
                                : movie.Description.Substring(0, Math.Min(100, movie.Description.Length)))...
                            </p>
                            <a href="@Url.Action("Details", "Movies", new { id = movie.MovieId })"
                               class="btn btn-primary"
                               data-id="@movie.MovieId">
                                Xem ngay
                            </a>
                        </div>
                    </div>
                }
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#movieSlider" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>

            <button class="carousel-control-next" type="button" data-bs-target="#movieSlider" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>
    <!-- ========== BANNER TOP ========== -->
    @if (!isVip)
    {
        <div class="banner-top-area">
            <div class="banner-top-wrapper">
                @if (ViewBag.BannersTop != null)
                {
                    foreach (var b in ViewBag.BannersTop)
                    {
                        <a href="@b.TargetUrl" target="_blank">
                            <img src="@Url.Content(b.ImagePath)" alt="banner top" class="banner-top-img" />
                        </a>
                    }
                }
            </div>
        </div>
    }



    <!-- ========== FEATURED MOVIES ========== -->
    <div class="featured-movies-wrapper page-index">
        <h3 class="featured-section-title fw-bold">⭐ Phim thịnh hành</h3>

        <div class="row g-3 featured-movies">
            @foreach (var movie in featuredMovies)
            {
                <div class="col-md-3 col-sm-6">
                    <div class="featured-card h-100 text-center">
                        <img src="@Url.Content(string.IsNullOrEmpty(movie.PosterPath) ? "~/Content/Images/no-poster.png" : movie.PosterPath)"
                             class="featured-poster" alt="@movie.Title" />

                        <div class="featured-body">
                            <h6 class="featured-title fw-bold">@movie.Title</h6>

                            <div class="featured-actions">
                                <a href="@Url.Action("Details","Movies", new { id = movie.MovieId })" class="featured-btn-xem" data-id="@movie.MovieId">▶ Xem</a>
                                <button class="featured-fav-btn @(ViewBag.UserFavorites != null && ((List<int>)ViewBag.UserFavorites).Contains(movie.MovieId) ? "btn-danger" : "btn-outline-danger")"
                                        data-id="@movie.MovieId">
                                    @(ViewBag.UserFavorites != null && ((List<int>)ViewBag.UserFavorites).Contains(movie.MovieId) ? "💔" : "❤️")
                                </button>
                                <div class="featured-views">
                                    <span class="icon">👁️</span>
                                    <span class="count">@movie.ViewCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    @if (!isVip)
    {
        <div class="container mt-3">
            <div class="banner-mid-wrapper">
                @if (ViewBag.BannersMid != null)
                {
                    foreach (var b in ViewBag.BannersMid)
                    {
                        <a href="@b.TargetUrl" target="_blank">
                            <img src="@Url.Content(b.ImagePath)" alt="banner mid" class="banner-mid-img" />
                        </a>
                    }
                }
            </div>
        </div>
    }



    <!-- ========== PHIM THEO THỂ LOẠI ========== -->
    <div class="movies-carousel">
        <h3 class="mb-3 fw-bold">🎥 Phim theo thể loại</h3>

        @{
            var moviesByGenre = ViewBag.MoviesByGenre as Dictionary<WEBXEMPHIMHKTMOVIE.Models.Genre, List<WEBXEMPHIMHKTMOVIE.Models.Movie>>;
        }

        @if (moviesByGenre != null)
        {
            foreach (var kvp in moviesByGenre)
            {
                var genre = kvp.Key;
                var movies = kvp.Value;
                if (movies.Count == 0) { continue; }

                <div class="genre-section mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0">@genre.GenreName</h4>
                        <a href="@Url.Action("ByGenre", "Movies", new { id = genre.GenreId })"
                           class="text-decoration-none xem-toan-bo">
                            Xem toàn bộ &raquo;
                        </a>
                    </div>

                    <div class="movie-row d-flex flex-row flex-nowrap">
                        @foreach (var movie in movies)
                        {
                            <a href="@Url.Action("Details", "Movies", new { id = movie.MovieId })"
                               class="movie-card me-3 text-decoration-none">
                                <img src="@Url.Content(string.IsNullOrEmpty(movie.PosterPath) ? "~/Content/Images/no-poster.png" : movie.PosterPath)"
                                     class="movie-poster" alt="@movie.Title" />

                                <div class="card-body">
                                    <h6 class="card-title">@movie.Title</h6>
                                    <div class="movie-views">
                                        <span class="icon">👁️</span>
                                        <span class="count">@movie.ViewCount</span>
                                    </div>
                                </div>

                                <span class="btn-xem" data-id="@movie.MovieId">Xem</span>
                            </a>
                        }
                    </div>

                </div>
            }
        }
    </div>
    <!-- ========== BANNER BOTTOM ========== -->
    @if (!isVip && ViewBag.BannersBottom != null)
    {
        foreach (var b in ViewBag.BannersBottom)
        {
            <div class="container my-5">
                <a href="@b.TargetUrl" target="_blank">
                    <img src="@Url.Content(b.ImagePath)"
                         class="img-fluid w-100 rounded shadow" />
                </a>
            </div>
        }
    }




    <!-- ========== PHÂN TRANG (động) ========== -->
    @*<nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1 })">«</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1 })">»</a>
                </li>
            </ul>
        </nav>*@
</div>
@if (!isVip && ViewBag.PopupBanner != null)
{
    <div id="popup-overlay" class="popup-overlay">
        <div id="popup-ads" class="popup-ads">
            <span class="popup-close">&times;</span>

            <a href="@ViewBag.PopupBanner.TargetUrl" target="_blank">
                <img src="@Url.Content(ViewBag.PopupBanner.ImagePath)"
                     alt="popup banner"
                     class="popup-img" />
            </a>
        </div>
    </div>
}



<!-- ========== Nút thêm yêu thích ========== -->
@section scripts {
    <script>
        $(document).on("click", ".featured-fav-btn", function () {
        var btn = $(this);
        var movieId = btn.data("id");

        $.post("@Url.Action("ToggleFavorite", "Favorites")", { movieId: movieId }, function (res) {
            if (res.success) {
                if (res.isFavorite) {
                    // Đổi nút thành màu đỏ, text 💔
                    btn.removeClass("btn-outline-danger").addClass("btn-danger").text("💔");
                    showMessage("✅ Đã thêm vào danh sách yêu thích!");
                } else {
                    // Đổi nút về mặc định, text ❤️
                    btn.removeClass("btn-danger").addClass("btn-outline-danger").text("❤️");
                    showMessage("❌ Đã xoá khỏi danh sách yêu thích!");
                }
            } else {
                alert(res.message || "Có lỗi xảy ra.");
            }
        });
    });

    // Hiển thị thông báo (toast đơn giản)
    function showMessage(msg) {
        var alertBox = $('<div class="alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 2000;">'
            + msg +
            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        $("body").append(alertBox);

        setTimeout(function () {
            alertBox.alert('close');
        }, 2500); // Tự ẩn sau 2.5s
        }
    // GHI LỊCH SỬ XEM PHIM
    $(document).on("click", ".btn-watch", function () {
    var movieId = $(this).data("id");

    $.post("@Url.Action("Add","WatchHistory")", { movieId: movieId }, function(res){
        console.log("WatchHistory saved:", res);
    });
});
    </script>
    <script>
    $(document).ready(function () {

        // Lấy giá trị VIP từ Razor
        var isVip = @((ViewBag.IsVip != null && (bool)ViewBag.IsVip) ? "true" : "false");

        // Nếu KHÔNG phải VIP → hiển thị popup
        if (!isVip) {

            // Canh giữa popup bằng flex (nhưng vẫn ẩn lúc đầu)
            $("#popup-overlay").css("display", "flex").hide().fadeIn(200);

        }

        // Sự kiện đóng popup
        $(".popup-close").click(function () {
            $("#popup-overlay").fadeOut(200);
        });

        // Click ra ngoài -> tắt popup
        $("#popup-overlay").click(function (e) {
            if (e.target.id === "popup-overlay") {
                $("#popup-overlay").fadeOut(200);
            }
        });

    });
    </script>






}

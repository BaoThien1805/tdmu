@model IEnumerable<MovieWebApp.Models.Movie>
@{
    ViewBag.Title = "Trang chủ";
    var sliderMovies = ViewBag.SliderMovies as List<MovieWebApp.Models.Movie>;
    var genres = ViewBag.Genres as List<MovieWebApp.Models.Genre>;
    var featuredMovies = ViewBag.FeaturedMovies as List<MovieWebApp.Models.Movie>;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}
<!-- Hiển thị thông báo lỗi nếu có -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger text-center">
        @TempData["Error"]
    </div>
}

<div class="container mt-4">

    <!-- ========== SLIDER ========== -->
    <div id="movieSlider" class="carousel slide mb-5" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < sliderMovies.Count; i++)
            {
                var movie = sliderMovies[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@Url.Content(movie.PosterPath)" class="d-block w-100" alt="@movie.Title" style="height:400px; object-fit:cover;" />
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3">
                        <h5>@movie.Title</h5>
                        <p>@(string.IsNullOrEmpty(movie.Description) ? "" : movie.Description.Substring(0, Math.Min(100, movie.Description.Length)))...</p>
                        <a href="@Url.Action("Details", "Movies", new { id = movie.MovieId })" class="btn btn-primary">Xem ngay</a>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#movieSlider" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#movieSlider" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <!-- ========== GENRES ========== -->
    @* --- THỂ LOẠI PHIM --- *@
    <div class="container mt-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold">📂 Thể loại phim</h3>
            <hr class="w-25 mx-auto border-3 border-primary" />
        </div>

        <div class="row g-3 justify-content-center">
            @foreach (var genre in ViewBag.Genres as List<MovieWebApp.Models.Genre>)
            {
                <div class="col-lg-2 col-md-3 col-sm-4 col-6">
                    <a href="@Url.Action("ByGenre", "Movies", new { id = genre.GenreId })"
                       class="btn btn-outline-primary w-100 py-3 fw-semibold genre-btn">
                        🎬 @genre.GenreName
                    </a>
                </div>
            }
        </div>
    </div>
    <!-- ========== FEATURED MOVIES ========== -->
    <h3 class="mb-3 fw-bold">⭐ Phim thịnh hành </h3>
    <div class="row g-3 mb-5 featured-movies">
        @foreach (var movie in featuredMovies)
        {
            <div class="col-md-3 col-sm-6">
                <div class="featured-card h-100 text-center">
                    <img src="@Url.Content(string.IsNullOrEmpty(movie.PosterPath) ? "~/Content/Images/no-poster.png" : movie.PosterPath)"
                         class="featured-poster" alt="@movie.Title" />
                    <div class="featured-body d-flex flex-column">
                        <h6 class="featured-title fw-bold flex-grow-1">@movie.Title</h6>

                        <!-- cụm 3 nút -->
                        <div class="featured-actions mt-auto">
                            <a href="@Url.Action("Details","Movies", new { id = movie.MovieId })" class="featured-btn-xem">Xem ngay</a>
                            <button class="featured-fav-btn @(ViewBag.UserFavorites != null && ((List<int>)ViewBag.UserFavorites).Contains(movie.MovieId) ? "btn-danger" : "btn-outline-danger")"
                                    data-id="@movie.MovieId">
                                @(ViewBag.UserFavorites != null && ((List<int>)ViewBag.UserFavorites).Contains(movie.MovieId) ? "💔" : "❤️")
                            </button>
                            <div class="featured-views">
                                <span class="icon">👁️</span>
                                <span class="count">@movie.ViewCount</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>

    <!-- ========== PHIM THEO THỂ LOẠI ========== -->
    <div class="movies-carousel">
        <h3 class="mb-3 fw-bold">🎥 Phim theo thể loại</h3>

        @{
            var moviesByGenre = ViewBag.MoviesByGenre as Dictionary<MovieWebApp.Models.Genre, List<MovieWebApp.Models.Movie>>;
        }

        @if (moviesByGenre != null)
        {
            foreach (var kvp in moviesByGenre)
            {
                var genre = kvp.Key;
                var movies = kvp.Value;
                if (movies.Count == 0) { continue; }

                <div class="genre-section mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0">@genre.GenreName</h4>
                        <a href="@Url.Action("ByGenre","Movies", new { id = genre.GenreId })" class="text-decoration-none xem-toan-bo">
                            Xem toàn bộ &raquo;
                        </a>

                    </div>

                    <div class="movie-row d-flex flex-row flex-nowrap">
                        @foreach (var movie in movies)
                        {
                            <div class="movie-card me-3">
                                <img src="@Url.Content(string.IsNullOrEmpty(movie.PosterPath) ? "~/Content/Images/no-poster.png" : movie.PosterPath)"
                                     class="movie-poster" alt="@movie.Title" />
                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title fw-bold flex-grow-1">@movie.Title</h6>
                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <a href="@Url.Action("Details","Movies", new { id = movie.MovieId })" class="btn-xem">Xem</a>
                                        <div class="movie-views">
                                            <span class="icon">👁️</span>
                                            <span class="count">@movie.ViewCount</span>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- ========== PHÂN TRANG (động) ========== -->
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1 })">«</a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1 })">»</a>
            </li>
        </ul>
    </nav>
</div>
<!-- ========== Nút thêm yêu thích ========== -->
@section scripts {
    <script>
        $(document).on("click", ".featured-fav-btn", function () {
        var btn = $(this);
        var movieId = btn.data("id");

        $.post("@Url.Action("ToggleFavorite", "Favorites")", { movieId: movieId }, function (res) {
            if (res.success) {
                if (res.isFavorite) {
                    // Đổi nút thành màu đỏ, text 💔
                    btn.removeClass("btn-outline-danger").addClass("btn-danger").text("💔");
                    showMessage("✅ Đã thêm vào danh sách yêu thích!");
                } else {
                    // Đổi nút về mặc định, text ❤️
                    btn.removeClass("btn-danger").addClass("btn-outline-danger").text("❤️");
                    showMessage("❌ Đã xoá khỏi danh sách yêu thích!");
                }
            } else {
                alert(res.message || "Có lỗi xảy ra.");
            }
        });
    });

    // Hiển thị thông báo (toast đơn giản)
    function showMessage(msg) {
        var alertBox = $('<div class="alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 2000;">'
            + msg +
            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        $("body").append(alertBox);

        setTimeout(function () {
            alertBox.alert('close');
        }, 2500); // Tự ẩn sau 2.5s
    }
    </script>
}


@model IEnumerable<WEBXEMPHIMHKTMOVIE.Models.Movie>
@{
    ViewBag.Title = "Phim yêu thích";
}
<link rel="stylesheet" href="~/Content/css/MyFavorite.css" />

<div class="container mt-4">
    <h2 class="mb-4 fw-bold text-center">❤️ Phim yêu thích của tôi</h2>

    <div class="row g-3">
        @foreach (var movie in Model)
        {
            <div class="col-md-3 col-sm-6">
                <div class="movie-card h-100 text-center">
                    <img src="@Url.Content(string.IsNullOrEmpty(movie.PosterPath) ? "~/Content/Images/no-poster.png" : movie.PosterPath)"
                         class="movie-poster" alt="@movie.Title" />

                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title fw-bold text-truncate flex-grow-1">@movie.Title</h6>

                        <div class="d-flex justify-content-center align-items-center gap-2 mt-auto">
                            <a href="@Url.Action("Details", "Movies", new { id = movie.MovieId })"
                               class="btn-xem">Xem chi tiết</a>

                            <button class="favorite-btn" data-id="@movie.MovieId">💔</button>

                            <div class="movie-views">
                                <span class="icon">👁️</span>
                                <span class="count">@movie.ViewCount</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Lấy danh sách phim đã yêu thích từ localStorage
            let favorites = JSON.parse(localStorage.getItem("favoriteMovies")) || [];

            // Áp dụng trạng thái yêu thích ban đầu
            document.querySelectorAll(".favorite-btn").forEach(btn => {
                const movieId = btn.dataset.id;
                if (favorites.includes(movieId)) {
                    btn.innerHTML = "❤️";
                    btn.classList.add("active");
                }

                // Khi bấm nút 💔 / ❤️
                btn.addEventListener("click", function () {
                    if (favorites.includes(movieId)) {
                        // Xóa khỏi danh sách
                        favorites = favorites.filter(id => id !== movieId);
                        btn.innerHTML = "💔";
                        btn.classList.remove("active");
                    } else {
                        // Thêm vào danh sách
                        favorites.push(movieId);
                        btn.innerHTML = "❤️";
                        btn.classList.add("active");

                        // Hiệu ứng trái tim nảy lên
                        btn.classList.add("pulse");
                        setTimeout(() => btn.classList.remove("pulse"), 500);
                    }

                    // Lưu lại danh sách yêu thích
                    localStorage.setItem("favoriteMovies", JSON.stringify(favorites));
                });
            });
        });
    </script>
}

@{
    ViewBag.Title = "Đăng nhập";
}

<div class="login-container">
    <div class="login-box">
        <!-- Bên trái: logo + background -->
        <div class="login-left" style="background-image: url('@Url.Content("~/Content/Images/bg.jpg")');">
            <div class="overlay"></div>
            <div class="login-left-content text-center">
                <img src="@Url.Content("~/Content/Images/logo.png")" alt="Logo" class="login-logo" />
            </div>
        </div>

        <!-- Bên phải: Form -->
        <div class="login-right">
            <h3 class="mb-3">Đăng nhập</h3>
            <p>
                Nếu bạn chưa có tài khoản,
                @Html.ActionLink("đăng ký ngay", "Register", "Account", null, new { @class = "link-register" })
            </p>

            <!-- Thông báo lỗi -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <input type="text" name="username" class="login-input" placeholder="Email" required />
                </div>
                <div class="mb-3">
                    <input type="password" name="password" class="login-input" placeholder="Mật khẩu" required />
                </div>

                <button type="submit" class="btn btn-login w-100">Đăng nhập</button>
            }

            <div class="text-center mt-3">
                <a href="#" class="forgot-link">Quên mật khẩu?</a>
            </div>

            <div class="mt-3">
                <button class="btn btn-google w-100">
                    <img src="https://developers.google.com/identity/images/g-logo.png" width="18" class="me-2" />
                    Đăng nhập bằng Google
                </button>
            </div>
        </div>
    </div>
</div>

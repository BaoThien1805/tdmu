@{
    ViewBag.Title = "Đăng nhập";
}
<link rel="stylesheet" href="~/Content/css/login.css" />
<div class="login-container">
    <div class="login-box">
        <!-- ========== BÊN TRÁI: ẢNH NỀN + LOGO ========== -->
        <div class="login-left" style="background-image: url('@Url.Content("~/Content/Images/bg.jpg")');">
            <div class="overlay"></div>
            <div class="login-left-content text-center">
                <img src="@Url.Content("~/Content/Images/logo.png")" alt="Logo" class="login-logo" />
            </div>
        </div>

        <!-- ========== BÊN PHẢI: FORM ĐĂNG NHẬP ========== -->
        <div class="login-right">
            <h3 class="mb-3 fw-bold text-center">Đăng nhập</h3>
            <p class="text-center text-muted">
                Nếu bạn chưa có tài khoản,
                @Html.ActionLink("đăng ký ngay", "Register", "Account", null, new { @class = "link-register fw-semibold" })
            </p>

            <!-- Hiển thị thông báo lỗi -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 text-center">@ViewBag.Error</div>
            }

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <input type="text" name="Username" class="login-input" placeholder="Email hoặc Tên đăng nhập" required />
                </div>
                <div class="mb-3">
                    <input type="password" name="Password" class="login-input" placeholder="Mật khẩu" required />
                </div>
                <button type="submit" class="btn btn-login w-100">Đăng nhập</button>
            }

            <div class="text-center mt-3">
                <a href="#" class="forgot-link">Quên mật khẩu?</a>
            </div>

            <div class="mt-3">
                <button class="btn btn-google w-100">
                    <img src="https://developers.google.com/identity/images/g-logo.png" width="18" class="me-2" />
                    Đăng nhập bằng Google
                </button>
            </div>

        </div>
    </div>
</div>

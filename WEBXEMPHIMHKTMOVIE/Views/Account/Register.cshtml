@model WEBXEMPHIMHKTMOVIE.Models.User
@{
    ViewBag.Title = "Đăng ký";
}
<link rel="stylesheet" href="~/Content/css/login.css" />
<div class="login-container">
    <div class="login-box">
        <!-- ========== BÊN TRÁI: LOGO + BACKGROUND ========== -->
        <div class="login-left" style="background-image: url('@Url.Content("~/Content/Images/bg.jpg")');">
            <div class="overlay"></div>
            <div class="login-left-content text-center">
                <img src="@Url.Content("~/Content/Images/logo.png")" alt="Logo" class="login-logo" />
            </div>
        </div>

        <!-- ========== BÊN PHẢI: FORM ĐĂNG KÝ ========== -->
        <div class="login-right">
            <h3 class="mb-3 fw-bold text-center">Tạo tài khoản</h3>
            <p class="text-center text-muted">
                Bạn đã có tài khoản?
                @Html.ActionLink("đăng nhập ngay", "Login", "Account", null, new { @class = "link-register fw-semibold" })
            </p>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <input type="text" name="FullName" class="login-input" placeholder="Họ tên" required />
                </div>

                <div class="mb-3">
                    <input type="email" name="Email" class="login-input" placeholder="Email" required />
                </div>

                <div class="mb-3">
                    <input type="text" name="Username" class="login-input" placeholder="Tên đăng nhập (tuỳ chọn)" />
                </div>

                <div class="mb-3">
                    <input type="password" name="PasswordHash" class="login-input" placeholder="Mật khẩu" required />
                </div>

                <div class="mb-3">
                    <input type="password" name="PasswordConfirm" class="login-input" placeholder="Xác nhận mật khẩu" required />
                </div>

                <button type="submit" class="btn btn-login w-100">Đăng ký</button>

                if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3 text-center">@ViewBag.Error</div>
                }
            }
        </div>
    </div>
</div>

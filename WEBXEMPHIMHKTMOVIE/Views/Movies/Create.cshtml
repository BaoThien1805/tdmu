@model MovieWebApp.Models.Movie

@{
    ViewBag.Title = "Thêm phim";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Header -->
        <div class="card-header bg-primary text-white text-center rounded-top-4 py-3">
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-film me-2"></i> Thêm phim mới
            </h4>
        </div>

        <!-- Body -->
        <div class="card-body p-4 bg-light text-dark">
            <!-- text-dark = chữ đen -->
            @using (Html.BeginForm("Create", "Movies", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Title, "Tiêu đề", new { @class = "form-label fw-bold text-dark" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control text-dark", placeholder = "Nhập tên phim..." })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.ReleaseYear, "Năm phát hành", new { @class = "form-label fw-bold text-dark" })
                            @Html.TextBoxFor(m => m.ReleaseYear, new { @class = "form-control text-dark", type = "number", min = "1900", max = "2100" })
                        </div>

                        <div class="mb-3">
                            @Html.Label("Thể loại", new { @class = "form-label fw-bold text-dark" })
                            @Html.DropDownList("GenreId", null, "Chọn thể loại", new { @class = "form-select text-dark" })
                        </div>

                        <div class="form-check mb-3">
                            @Html.CheckBoxFor(m => m.IsSeries, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.IsSeries, "Phim bộ", new { @class = "form-check-label fw-bold text-dark" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Description, "Mô tả", new { @class = "form-label fw-bold text-dark" })
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control text-dark", rows = 6, placeholder = "Nhập mô tả phim..." })
                        </div>

                        <div class="mb-3">
                            @Html.Label("Ảnh poster", new { @class = "form-label fw-bold text-dark" })
                            <input type="file" name="PosterFile" class="form-control text-dark" accept="image/*" onchange="previewPoster(event)" />
                            <div class="mt-2">
                                <img id="posterPreview" src="#" alt="Poster Preview" style="max-height:200px; display:none;" class="rounded shadow" />
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.Label("Video (URL hoặc ~/Content/Videos/tenphim.mp4)", new { @class = "form-label fw-bold text-dark" })
                            @Html.TextBoxFor(m => m.VideoPath, new { @class = "form-control text-dark", placeholder = "~/Content/Videos/tenphim.mp4" })
                        </div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-success px-4 me-2">
                        <i class="bi bi-save me-1"></i> Lưu
                    </button>
                    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary px-4" })
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewPoster(event) {
            var output = document.getElementById('posterPreview');
            output.src = URL.createObjectURL(event.target.files[0]);
            output.style.display = 'block';
        }
    </script>
}
<!-- Khi bạn chọn poster từ máy tính → hàm previewPoster() chạy 
    → tạo link tạm của file → gán vào <img id="posterPreview"> → hiển thị preview ngay lập tức.-->

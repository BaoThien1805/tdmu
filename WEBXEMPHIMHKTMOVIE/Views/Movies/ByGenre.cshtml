@model IEnumerable<MovieWebApp.Models.Movie>
@{
    ViewBag.Title = "Phim thể loại " + ViewBag.GenreName;
}

<div class="container mt-5">
    <!-- Tiêu đề -->
    <div class="text-center mb-4">
        <h2 class="fw-bold">
            🎬 Thể loại: <span class="text-primary">@ViewBag.GenreName</span>
        </h2>
        <hr class="w-25 mx-auto border-3 border-primary" />
    </div>

    <!-- Danh sách phim -->
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center">
                <p class="text-muted fst-italic">Chưa có phim nào trong thể loại này.</p>
            </div>
        }
        else
        {
            foreach (var movie in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden movie-card">
                        <img src="@Url.Content(movie.PosterPath)"
                             class="card-img-top"
                             alt="@movie.Title"
                             style="height:280px; object-fit:cover;" />

                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-bold text-truncate" title="@movie.Title">@movie.Title</h6>
                            <p class="text-muted small mb-2">👁️ @movie.ViewCount lượt xem</p>
                            <a href="@Url.Action("Details", "Movies", new { id = movie.MovieId })"
                               class="btn btn-outline-primary btn-sm mt-auto">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Phân trang -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("ByGenre", "Movies", new { id = Request["id"], page = ViewBag.CurrentPage - 1 })">«</a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("ByGenre", "Movies", new { id = Request["id"], page = i })">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("ByGenre", "Movies", new { id = Request["id"], page = ViewBag.CurrentPage + 1 })">»</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- CSS custom -->
<style>
    .movie-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    .card-title {
        font-size: 0.95rem;
        line-height: 1.2rem;
    }
</style>

@model IEnumerable<WEBXEMPHIMHKTMOVIE.Models.Movie>

@{
    ViewBag.Title = "Phim lẻ";
}
@section Styles {
    <link rel="stylesheet" href="~/Content/css/PhimLe.css" />
}

<div class="container mt-5">
    <h2 class="fw-bold mb-4 text-center">@ViewBag.Title</h2>

    <div class="row g-4">
        @foreach (var movie in Model)
        {
            <div class="col-md-3 col-sm-6 col-6">
                <div class="card movie-card h-100">
                    <img src="@Url.Content(string.IsNullOrEmpty(movie.PosterPath) ? "~/Content/Images/no-poster.png" : movie.PosterPath)"
                         alt="@movie.Title" />

                    <div class="card-body">
                        <h6 class="card-title">@movie.Title</h6>
                        <span class="text-muted">
                            👁️ @movie.ViewCount
                        </span>

                        <div class="mt-2">
                            <a href="@Url.Action("Details", "Movies", new { id = movie.MovieId })"
                               class="btn btn-outline-primary btn-sm">Xem</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

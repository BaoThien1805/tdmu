@model IEnumerable<MovieWebApp.Models.Movie>
@{
    ViewBag.Title = "Phim lẻ";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4 text-center">@ViewBag.Title</h2>

    <div class="row g-3">
        @foreach (var movie in Model)
        {
            <div class="col-md-3 col-sm-6 col-6">
                <div class="card movie-card h-100 text-center">
                    <img src="@Url.Content(string.IsNullOrEmpty(movie.PosterPath) ? "~/Content/Images/no-poster.png" : movie.PosterPath)"
                         class="card-img-top movie-poster" alt="@movie.Title" />
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title fw-bold flex-grow-1 text-truncate">@movie.Title</h6>

                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <a href="@Url.Action("Details", "Movies", new { id = movie.MovieId })" class="btn-xem">Xem</a>
                            <div class="movie-views">
                                <span class="icon">👁️</span>
                                <span class="count">@movie.ViewCount</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

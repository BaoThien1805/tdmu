@model IEnumerable<MovieWebApp.Models.Movie>
@{
    ViewBag.Title = "Quản lý phim";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Header -->
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center rounded-top-4">
            <h4 class="mb-0"><i class="bi bi-film me-2"></i> Quản lý phim</h4>
            @Html.ActionLink("➕ Thêm phim mới", "Create", null, new { @class = "btn btn-primary btn-sm fw-bold" })
        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">Poster</th>
                        <th>Tiêu đề</th>
                        <th>Thể loại</th>
                        <th>Loại phim</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PosterPath))
                                {
                                    <img src="@Url.Content(item.PosterPath)" class="img-thumbnail rounded" style="height:60px; width:auto;" />
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Chưa có poster</span>
                                }
                            </td>
                            <td class="fw-bold">@item.Title</td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    @(item.Genre != null ? item.Genre.GenreName : "Không có")
                                </span>
                            </td>
                            <td>
                                @if (item.IsSeries)
                                {
                                    <span class="badge bg-warning text-dark">Phim bộ</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Phim lẻ</span>
                                }
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                @Html.ActionLink("Chi tiết", "Details", new { id = item.MovieId }, new { @class = "btn btn-info btn-sm me-1" })
                                @Html.ActionLink("Sửa", "Edit", new { id = item.MovieId }, new { @class = "btn btn-warning btn-sm me-1 text-white" })
                                @Html.ActionLink("Xóa", "Delete", new { id = item.MovieId }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Bạn có chắc chắn muốn xóa phim này?');" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<WEBXEMPHIMHKTMOVIE.Models.Movie>
@{
    ViewBag.Title = "Phim bộ";
}
<link rel="stylesheet" href="~/Content/css/PhimBo.css" />
<div class="container mt-5">
    <h2 class="fw-bold mb-4 text-center">@ViewBag.Title</h2>

    <div class="row g-4">
        @foreach (var movie in Model)
        {
            <div class="col-md-3 col-sm-6 col-6">
                <div class="card movie-card h-100 text-center">
                    <img src="@Url.Content(string.IsNullOrEmpty(movie.PosterPath) ? "~/Content/Images/no-poster.png" : movie.PosterPath)"
                         alt="@movie.Title" />

                    <div class="card-body d-flex flex-column justify-content-between">
                        <h6 class="card-title fw-bold text-truncate">@movie.Title</h6>

                        <div class="mt-auto">
                            <div class="movie-views mb-2">
                                👁️ @movie.ViewCount
                            </div>
                            <a href="@Url.Action("Details", "Movies", new { id = movie.MovieId })"
                               class="btn btn-outline-primary btn-sm">Xem</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
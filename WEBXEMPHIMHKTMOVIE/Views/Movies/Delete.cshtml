@model MovieWebApp.Models.Movie

@{
    ViewBag.Title = "Xóa phim";
}

<h2>Bạn có chắc muốn xóa phim này không?</h2>

<div class="mb-3">
    <h4>@Model.Title</h4>
    <p>@Model.Description</p>
    <p>Thể loại: @(Model.Genre != null ? Model.Genre.GenreName : "Không có")</p>

    @if (!string.IsNullOrEmpty(Model.PosterPath))
    {
        <img src="@Url.Content(Model.PosterPath)" alt="@Model.Title" width="150" />
    }
    else
    {
        <span class="text-muted">Chưa có poster</span>
    }
</div>

@using (Html.BeginForm("Delete", "Movies", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MovieId)

    <button type="submit" class="btn btn-danger">Xóa</button>
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
}

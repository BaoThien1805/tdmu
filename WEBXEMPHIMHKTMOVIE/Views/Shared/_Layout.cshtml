@using System

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HKT Movie</title>

    <link href="~/Content/site.css" rel="stylesheet" />

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @{
        var username = (Session["Username"] ?? "").ToString();
        var fullname = (Session["FullName"] ?? username).ToString();
        var role = (Session["Role"] ?? "").ToString().ToLower();
        var isLogged = !string.IsNullOrEmpty(username);
        var isAdmin = (role == "admin");
    }

    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <img src="~/Content/Images/logo.png" alt="MyMovies" style="height:50px;" />
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">@Html.ActionLink("Trang chủ", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Phim bộ", "Series", "Movies", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Phim lẻ", "Single", "Movies", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("MyFavorites", "Favorites")">❤️ Phim yêu thích</a>
                    </li>

                </ul>

                @* Thanh tìm kiếm *@
                @using (Html.BeginForm("Search", "Movies", FormMethod.Get, new { @class = "d-flex" }))
                {
                    <input type="text" name="query" class="form-control me-2" placeholder="Tìm phim..." />
                    <button type="submit" class="btn btn-outline-light">Tìm</button>
                }

                <ul class="navbar-nav ms-3">
                    @if (!isLogged)
                    {
                        <li class="nav-item">@Html.ActionLink("Đăng nhập", "Login", "Account", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Đăng ký", "Register", "Account", null, new { @class = "nav-link" })</li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-light" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                👤 Xin chào, @fullname
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" aria-labelledby="userMenu">
                                <li>@Html.ActionLink("Đăng xuất", "Logout", "Account", null, new { @class = "dropdown-item" })</li>

                                @if (isAdmin)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>@Html.ActionLink("Quản lý Users", "Index", "Users", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Quản lý Phim", "Index", "Movies", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Quản lý Thể loại", "Index", "Genres", null, new { @class = "dropdown-item" })</li>
                                }
                            </ul>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>

    <div class="container body-content mt-4">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - MovieWebApp</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
</body>
</html>
<!-- ========== Nút thêm yêu thích ========== -->
@section scripts {
    <script>
        $(document).on("click", ".featured-fav-btn", function () {
        var btn = $(this);
        var movieId = btn.data("id");

        $.post("@Url.Action("ToggleFavorite", "Favorites")", { movieId: movieId }, function (res) {
            if (res.success) {
                if (res.isFavorite) {
                    // Đổi nút thành màu đỏ, text 💔
                    btn.removeClass("btn-outline-danger").addClass("btn-danger").text("💔");
                    showMessage("✅ Đã thêm vào danh sách yêu thích!");
                } else {
                    // Đổi nút về mặc định, text ❤️
                    btn.removeClass("btn-danger").addClass("btn-outline-danger").text("❤️");
                    showMessage("❌ Đã xoá khỏi danh sách yêu thích!");
                }
            } else {
                alert(res.message || "Có lỗi xảy ra.");
            }
        });
    });

    // Hiển thị thông báo (toast đơn giản)
    function showMessage(msg) {
        var alertBox = $('<div class="alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 2000;">'
            + msg +
            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        $("body").append(alertBox);

        setTimeout(function () {
            alertBox.alert('close');
        }, 2500); // Tự ẩn sau 2.5s
    }
    </script>
}


@using System

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HKT Movie</title>

    <!-- CSS chính -->
    <link href="~/Content/site.css" rel="stylesheet" />


    @Styles.Render("~/Content/css")
    @RenderSection("Styles", required: false)
    @Scripts.Render("~/bundles/modernizr")

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/rateYo/3.3.4/jquery.rateyo.min.css" />
</head>


<body>
    @{
        bool isLoggedIn = Session["UserId"] != null;
        bool isVip = Session["IsVip"] != null && (bool)Session["IsVip"];
        string fullName = Session["FullName"]?.ToString();
        DateTime? vipExpiredAt = Session["VipExpiredAt"] as DateTime?;
    }

    @{
        var email = (Session["Email"] ?? "").ToString();
        var fullname = (Session["FullName"] ?? "").ToString();
        var role = (Session["Role"] ?? "").ToString().ToLower();
        var isLogged = !string.IsNullOrEmpty(email);
        var isAdmin = (role == "admin");
    }

    <!-- ======= NAVBAR ======= -->
    <nav class="navbar navbar-expand-sm navbar-dark navbar-custom fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <img src="~/Content/Images/logo.png" alt="Logo" class="me-2" />

            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto ms-3">
                    <li class="nav-item">@Html.ActionLink("Trang chủ", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Phim bộ", "Series", "Movies", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Phim lẻ", "Single", "Movies", null, new { @class = "nav-link" })</li>
                    @Html.Action("GenreDropdown", "Genre", new { area = "" })


                    <li class="nav-item">@Html.ActionLink("Yêu thích ❤️", "MyFavorites", "Favorites", null, new { @class = "nav-link" })</li>
                    @if (Session["UserId"] != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index","WatchHistory")">
                                🕒 Lịch sử xem
                            </a>
                        </li>
                    }

                </ul>

                @using (Html.BeginForm("Search", "Movies", FormMethod.Get, new { @class = "d-flex align-items-center me-3" }))
                {
                    <input type="text" name="query" class="form-control me-2" placeholder="Tìm kiếm phim..." />
                    <button type="submit" class="btn btn-search">🔍</button>
                }

            <ul class="navbar-nav">
                @if (!isLogged)
                {
                    <li class="nav-item">
                        @Html.ActionLink("Đăng nhập", "Login", "Account", null, new { @class = "nav-link user-btn" })
                    </li>
                    <li class="nav-item ms-2">
                        @Html.ActionLink("Đăng ký", "Register", "Account", null, new { @class = "nav-link user-btn" })
                    </li>
                }
                else
                {
                    if (isLoggedIn && (!isVip || (vipExpiredAt != null && vipExpiredAt <= DateTime.Now)))
                    {
                        <li class="nav-item ms-2">
                            <a class="nav-link fw-bold text-warning vip-nav-btn"
                               href="@Url.Action("Index", "Vip")">
                                ⭐ Đăng ký VIP
                            </a>
                        </li>
                    }

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-light user-btn"
                           href="#"
                           id="userMenu"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            👤 @fullname

                            @* ========== VIP BADGE ========== *@
                            @if (isVip && (vipExpiredAt == null || vipExpiredAt > DateTime.Now))
                            {
                                <span class="badge bg-warning text-dark ms-1">VIP</span>
                            }
                        </a>

                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end"
                            aria-labelledby="userMenu">

                            @* Thông tin VIP *@
                            @if (isVip)
                            {
                                <li class="px-3 py-1 text-warning small">
                                    ⭐ VIP @(vipExpiredAt == null
                            ? "(Vĩnh viễn)"
                            : $"đến {vipExpiredAt.Value:dd/MM/yyyy}")
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                            }

                            <li>
                                @Html.ActionLink("Đăng xuất", "Logout", "Account", null,
                                    new { @class = "dropdown-item" })
                            </li>
                            <li>@Html.ActionLink("🎖️ Nâng cấp VIP", "Index", "Vip", null, new { @class = "dropdown-item text-warning fw-bold" })</li>

                            @if (isAdmin)
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li>@Html.ActionLink("Quản lý Users", "Index", "Users", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Quản lý Phim", "Index", "Movies", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Quản lý Thể loại", "Index", "Genres", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Quản lý Bình luận", "Index", "Comments", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Quản lý Đánh giá", "Index", "AdminRatings", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Nhật ký quản trị", "Index", "AdminLogs", new { area = "Admin" }, new { @class = "dropdown-item" })</li>
                            }
                        </ul>
                    </li>
                }
            </ul>

            </div>
        </div>
    </nav>

    <!-- ======= NỘI DUNG ======= -->
    <div class="container body-content" style="margin-top: 90px;">
        @RenderBody()
        <hr />
        @*<footer>
                <p>&copy; @DateTime.Now.Year - HKT Movie</p>
            </footer>*@
    </div>

    <!-- ======= SCRIPT ======= -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/rateYo/3.3.4/jquery.rateyo.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
@Html.Partial("Footer")
</html>

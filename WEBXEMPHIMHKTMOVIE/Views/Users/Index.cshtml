@model IEnumerable<MovieWebApp.Models.User>
@{
    ViewBag.Title = "Danh sách người dùng";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Header -->
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center rounded-top-4">
            <h4 class="mb-0"><i class="bi bi-people-fill me-2"></i>Danh sách người dùng</h4>
            @Html.ActionLink("➕ Thêm mới", "Create", null, new { @class = "btn btn-success btn-sm fw-bold" })
        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Tài khoản</th>
                        <th>Quyền</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td>@item.Username</td>
                            <td>
                                <span class="badge bg-primary">@item.Role</span>
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                @Html.ActionLink("Chi tiết", "Details", new { id = item.UserId }, new { @class = "btn btn-info btn-sm me-1" })
                                @Html.ActionLink("Sửa", "Edit", new { id = item.UserId }, new { @class = "btn btn-warning btn-sm me-1 text-white" })
                                @Html.ActionLink("Xóa", "Delete", new { id = item.UserId }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Bạn có chắc chắn muốn xóa người dùng này?');" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model MovieWebApp.Models.User
@{
    ViewBag.Title = "Chi tiết người dùng";
}
<h2>Chi tiết người dùng</h2>
<p><strong>ID:</strong> @Model.UserId</p>
<p><strong>Họ tên:</strong> @Model.FullName</p>
<p><strong>Email:</strong> @Model.Email</p>
<p><strong>Tài khoản:</strong> @Model.Username</p>
<p><strong>Quyền:</strong> @Model.Role</p>
<p><strong>Ngày tạo:</strong> @Model.CreatedAt</p>


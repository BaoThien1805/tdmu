@model MovieWebApp.Models.User
@{
    ViewBag.Title = "Thêm người dùng";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh; background: #f5f6fa;">
    <div class="card shadow-lg border-0 rounded-4" style="width: 500px;">
        <!-- Header -->
        <div class="card-header bg-dark text-white text-center rounded-top-4">
            <h4 class="mb-0">➕ Thêm người dùng</h4>
        </div>

        <!-- Body -->
        <div class="card-body p-4">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Họ tên</label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control form-control-lg", placeholder = "Nhập họ tên" })
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-lg", placeholder = "Nhập email" })
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Tài khoản</label>
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control form-control-lg", placeholder = "Nhập tên đăng nhập" })
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Mật khẩu</label>
                    @Html.PasswordFor(m => m.PasswordHash, new { @class = "form-control form-control-lg", placeholder = "Nhập mật khẩu" })
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 fw-bold rounded-3">
                    <i class="bi bi-save me-2"></i> Lưu người dùng
                </button>
            }
        </div>
    </div>
</div>

@model MovieWebApp.Models.User
@{
    ViewBag.Title = "Sửa thông tin người dùng";
}
<h2>Sửa thông tin người dùng</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.UserId)

    <div class="form-group">
        <label>Họ tên</label>
        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label>Email</label>
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label>Tài khoản</label>
        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="form-group">
        <label>Mật khẩu</label>
        @Html.PasswordFor(m => m.PasswordHash, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label>Quyền</label>
        @Html.TextBoxFor(m => m.Role, new { @class = "form-control" })
    </div>
    <button type="submit" class="btn btn-warning">Cập nhật</button>
}


@model IEnumerable<MovieWebApp.Models.Genre>
@{
    ViewBag.Title = "Danh sách thể loại";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Header -->
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center rounded-top-4">
            <h4 class="mb-0">
                <i class="bi bi-tags-fill me-2"></i> Danh sách thể loại
            </h4>
            <div>
                @* 🔙 Nút quay lại trang quản trị *@
                @Html.ActionLink(
                    "⬅️ Quay lại trang quản trị",
                    "Index",
                    "Home",
                    new { area = "Admin" },
                    new { @class = "btn btn-outline-light btn-sm me-2" }
                )

                @Html.ActionLink(
                    "➕ Thêm thể loại mới",
                    "Create",
                    new { area = "Admin" },
                    new { @class = "btn btn-primary btn-sm fw-bold" }
                )
            </div>
        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width:70%">Tên thể loại</th>
                        <th class="text-center" style="width:30%">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.GenreName</td>
                            <td class="text-center">
                                @Html.ActionLink("Chi tiết", "Details", new { area = "Admin", id = item.GenreId }, new { @class = "btn btn-info btn-sm me-1" })
                                @Html.ActionLink("Sửa", "Edit", new { area = "Admin", id = item.GenreId }, new { @class = "btn btn-warning btn-sm me-1 text-white" })
                                @Html.ActionLink("Xóa", "Delete", new { area = "Admin", id = item.GenreId }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Bạn có chắc chắn muốn xóa thể loại này?');" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

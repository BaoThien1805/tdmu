@model IEnumerable<WEBXEMPHIMHKTMOVIE.Models.Movie>

@{
    ViewBag.Title = "Quản lý phim";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-5 mb-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center rounded-top-4">
            <div class="d-flex align-items-center gap-2">
                <!-- 🔙 Nút quay lại -->
                <a href="@Url.Action("Index", "Home", new { area = "Admin" })" class="btn btn-secondary btn-sm fw-semibold">
                    ⬅️ Quay lại
                </a>
                <h4 class="mb-0"><i class="bi bi-collection-play me-2"></i> Danh sách phim</h4>
            </div>

            <!-- ➕ Nút thêm phim -->
            <a href="@Url.Action("Create", "Movies", new { area = "Admin" })"
               class="btn btn-success btn-sm fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Thêm phim mới
            </a>
        </div>

        <div class="card-body table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width:100px;">Poster</th>
                        <th>Tiêu đề</th>
                        <th>Thể loại</th>
                        <th class="text-center">Phim bộ?</th>
                        <th class="text-center">Ngày tạo</th>
                        <th class="text-center" style="width:180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    @{
                                        var poster = !string.IsNullOrEmpty(item.PosterPath)
                                            ? Url.Content(item.PosterPath)
                                            : Url.Content("~/Content/Images/no-image.png");
                                    }
                                    <img src="@poster" alt="@item.Title"
                                         class="img-thumbnail shadow-sm"
                                         style="max-height:80px; border-radius:8px;" />
                                </td>
                                <td class="fw-semibold">@item.Title</td>
                                <td>
                                    @(
        item.MovieGenres != null && item.MovieGenres.Any()
        ? string.Join(", ", item.MovieGenres.Select(g => g.Genre.GenreName))
        : "Chưa có"
    )
                                </td>

                                <td class="text-center">
                                    <span class="badge @(item.IsSeries ? "bg-info" : "bg-secondary")">
                                        @(item.IsSeries ? "Phim bộ" : "Phim lẻ")
                                    </span>
                                </td>
                                <td class="text-center text-muted">
                                    @item.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center">
                                    <!-- 🔍 Chi tiết -->
                                    <a href="@Url.Action("Details", "Movies", new { id = item.MovieId, area = "Admin" })"
                                       class="btn btn-info btn-sm text-white me-1" title="Xem chi tiết">
                                        🔍
                                    </a>
                                    <!-- ✏️ Sửa -->
                                    <a href="@Url.Action("Edit", "Movies", new { id = item.MovieId, area = "Admin" })"
                                       class="btn btn-warning btn-sm me-1 text-dark" title="Chỉnh sửa">
                                        ✏️
                                    </a>
                                    <!-- 🗑️ Xóa -->
                                    <a href="@Url.Action("Delete", "Movies", new { id = item.MovieId, area = "Admin" })"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Bạn có chắc muốn xóa phim này không?')"
                                       title="Xóa phim">
                                        🗑️
                                    </a>
                                    @if (item.IsSeries)
                                    {
                                        <a href="@Url.Action("Index", "Episodes", new { area = "Admin", movieId = item.MovieId })"
                                           class="btn btn-primary btn-sm mt-1" title="Quản lý tập phim">
                                            🎬 Tập phim
                                        </a>
                                    }

                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-exclamation-circle me-2"></i> Chưa có phim nào trong cơ sở dữ liệu.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



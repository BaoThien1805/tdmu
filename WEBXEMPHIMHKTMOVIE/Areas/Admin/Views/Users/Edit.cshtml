@model WEBXEMPHIMHKTMOVIE.Models.User
@{
    ViewBag.Title = "Chỉnh sửa người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card bg-dark text-light shadow-sm rounded-3">
        <div class="card-header text-center border-0 bg-secondary">
            <h4 class="mb-0">✏️ Chỉnh sửa người dùng</h4>
        </div>
        <div class="card-body p-3">
            @using (Html.BeginForm("Edit", "Users", new { area = "Admin" }, FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.UserId)

                <div class="mb-2">
                    <label class="form-label small">Họ tên</label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control form-control-sm bg-secondary text-light border-0", placeholder = "Nhập họ tên" })
                </div>

                <div class="mb-2">
                    <label class="form-label small">Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-sm bg-secondary text-light border-0", placeholder = "Nhập email" })
                </div>

                <div class="mb-3">
                    <label class="form-label small">Vai trò</label>
                    @Html.DropDownListFor(
                        m => m.Role,
                        new SelectList(new[] { "User", "Admin" }, Model.Role),
                        "-- Chọn vai trò --",
                        new { @class = "form-select form-select-sm bg-secondary text-light border-0" })
                </div>

                <button type="submit" class="btn btn-success btn-sm w-100 mb-2">
                    💾 Lưu thay đổi
                </button>

                <div class="text-center">
                    @Html.ActionLink("⬅️ Quay lại", "Index", "Users", new { area = "Admin" }, new { @class = "btn btn-outline-light btn-sm" })
                </div>
            }
        </div>
    </div>
</div>

<script>
    (() => {
        'use strict';
        const forms = document.querySelectorAll('.needs-validation');
        Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>

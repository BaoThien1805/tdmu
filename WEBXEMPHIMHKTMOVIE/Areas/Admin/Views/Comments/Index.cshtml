@model IEnumerable<WEBXEMPHIMHKTMOVIE.Models.Comment>
@{
    ViewBag.Title = "Quản lý Comments";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Nhúng CSS và FontAwesome -->
<link rel="stylesheet" href="~/Content/css/adminComments.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<div class="container mt-5 mb-4">
    <div class="card shadow-lg border-0 rounded-4">

        <!-- Header -->
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center rounded-top-4">
            <h4 class="mb-0">
                <i class="bi bi-chat-left-text-fill me-2"></i> Danh sách bình luận
            </h4>
        </div>

        <!-- Table -->
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:5%">ID</th>
                        <th style="width:15%">Người dùng</th>
                        <th style="width:20%">Phim</th>
                        <th style="width:40%">Nội dung</th>
                        <th style="width:15%">Ngày tạo</th>
                        <th class="text-center" style="width:10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comment in Model)
                    {
                        <tr id="row-@comment.CommentId">
                            <td class="text-center">@comment.CommentId</td>
                            <td>@comment.User.FullName</td>
                            <td>@comment.Movie.Title</td>

                            <td>
                                <span id="content-@comment.CommentId">@comment.Content</span>
                                <input type="text" class="form-control input-sm mt-1"
                                       style="display:none" id="input-@comment.CommentId"
                                       value="@comment.Content" />
                            </td>

                            <td>@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                            <td class="text-center">
                                <button class="btn btn-warning btn-sm me-1 text-dark"
                                        onclick="editComment(@comment.CommentId)">
                                    ✏️
                                </button>
                                <button class="btn btn-danger btn-sm"
                                        onclick="deleteComment(@comment.CommentId)">
                                    🗑️
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script type="text/javascript">
        // ================= XÓA COMMENT =================
        function deleteComment(commentId) {
            if (!confirm("Bạn có chắc muốn xóa comment này?")) return;

            $.ajax({
                url: '@Url.Action("Delete", "Comments", new { area = "Admin" })',
                type: 'POST',
                data: { commentId: commentId },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        $("#row-" + commentId).fadeOut('slow', function () { $(this).remove(); });
                    } else {
                        alert(response.message);
                    }
                },
                error: function () { alert("Có lỗi xảy ra."); }
            });
        }

        // ================= CHỈNH SỬA COMMENT INLINE =================
        function editComment(commentId) {
            var span = $("#content-" + commentId);
            var input = $("#input-" + commentId);

            if (input.is(":visible")) {
                // Gửi AJAX cập nhật
                $.ajax({
                    url: '@Url.Action("EditContent", "Comments", new { area = "Admin" })',
                    type: 'POST',
                    data: { commentId: commentId, content: input.val() },
                    success: function (response) {
                        if (response.success) {
                            span.text(input.val());
                            input.hide();
                            span.show();
                            alert(response.message);
                        } else {
                            alert(response.message);
                        }
                    }
                });
            } else {
                span.hide();
                input.show().focus();
            }
        }
    </script>
}

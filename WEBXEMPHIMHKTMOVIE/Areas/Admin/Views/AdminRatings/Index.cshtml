@model IEnumerable<WEBXEMPHIMHKTMOVIE.Models.Rating>

@{
    ViewBag.Title = "Quản lý Ratings";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-5 mb-4">
    <div class="card shadow-lg border-0 rounded-4">

        <!-- ===== Header ===== -->
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center rounded-top-4">
            <h4 class="mb-0">
                ⭐ Danh sách đánh giá (Ratings)
            </h4>
        </div>

        <!-- ===== Table ===== -->
        <div class="card-body table-responsive">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
            }

            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Người dùng</th>
                        <th>Phim</th>
                        <th>Điểm</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.RatingId">
                            <td>@item.RatingId</td>
                            <td>@item.User.FullName</td>
                            <td>@item.Movie.Title</td>

                            <td style="width: 110px;">
                                <input type="number"
                                       class="form-control form-control-sm text-center score-input"
                                       value="@item.Score" min="1" max="5" />
                            </td>

                            <td>@item.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>

                            <td class="text-center">
                                <!-- Nút update -->
                                <button class="btn btn-success btn-sm me-1 btn-update" title="Cập nhật">
                                    💾
                                </button>

                                <!-- Nút delete -->
                                <button class="btn btn-danger btn-sm btn-delete" title="Xoá">
                                    🗑️
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    // Debug URL
    console.log("DELETE URL:", '@Url.Action("Delete", "AdminRatings", new { area = "Admin" })');
    console.log("UPDATE URL:", '@Url.Action("Update", "AdminRatings", new { area = "Admin" })');

    // =================== UPDATE RATING =======================
    $(".btn-update").click(function () {
        var row = $(this).closest("tr");
        var id = row.data("id");
        var score = row.find(".score-input").val();

        $.post('@Url.Action("Update", "AdminRatings", new { area = "Admin" })', {
            ratingId: id,
            score: score,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        }, function (res) {
            if (res.success) {
                alert("✔ Cập nhật thành công!");
            } else {
                alert("❌ Lỗi: " + res.message);
            }
        });
    });

    // =================== DELETE RATING =======================
    $(".btn-delete").click(function () {
        if (!confirm("Bạn có chắc muốn xoá rating này?")) return;

        var row = $(this).closest("tr");
        var id = row.data("id");

        $.post('@Url.Action("Delete", "AdminRatings", new { area = "Admin" })', {
            ratingId: id,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        }, function (res) {
            if (res.success) {
                row.remove();
                alert("🗑 Xoá thành công!");
            } else {
                alert("❌ Lỗi: " + res.message);
            }
        });
    });
</script>

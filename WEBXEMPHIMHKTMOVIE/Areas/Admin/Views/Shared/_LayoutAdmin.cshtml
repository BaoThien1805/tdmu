@* Areas/Admin/Views/Shared/_LayoutAdmin.cshtml *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("Styles", required: false)

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>

    <!-- NAVBAR ADMIN -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-admin shadow-sm fixed-top">
        <div class="container">

            <!-- LOGO -->
            <a class="navbar-brand d-flex align-items-center fw-bold"
               href="@Url.Action("Index", "Home", new { area = "" })">
                <img src="~/Content/Images/logo.png" height="42"
                     class="me-2 rounded-circle border border-secondary shadow-sm" />
            </a>

            <!-- NÚT MOBILE -->
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#adminNav"
                    aria-controls="adminNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- MENU -->
            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Home", new { area="Admin" })">
                            <i class="bi bi-speedometer2 me-1"></i> Bảng điều khiển
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Movies", new { area="Admin" })">
                            <i class="bi bi-film me-1"></i> Quản lý phim
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Users", new { area="Admin" })">
                            <i class="bi bi-people-fill me-1"></i> Người dùng
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Genres", new { area="Admin" })">
                            <i class="bi bi-tags-fill me-1"></i> Thể loại
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Comments", new { area="Admin" })">
                            <i class="bi bi-chat-text-fill me-1"></i> Bình luận
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","AdminRatings", new { area="Admin" })">
                            <i class="bi bi-star-fill me-1"></i> Đánh giá
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","AdsBanners", new { area="Admin" })">
                            <i class="bi bi-badge-ad-fill me-1"></i> Quảng cáo
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","AdminLogs", new { area="Admin" })">
                            <i class="bi bi-clock-history me-1"></i> Nhật ký
                        </a>
                    </li>

                </ul>

                <!-- LOGIN/USER -->
                <div class="d-flex">
                    <a href="@Url.Action("Logout", "Account", new { area = "" })"
                       class="btn btn-danger fw-bold px-3 py-1">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- CSS -->
    <style>
        body {
            background-color: #121212;
            padding-top: 80px;
        }

        .navbar-admin {
            background-color: #1f1f1f !important;
            border-bottom: 1px solid #333;
        }

            .navbar-admin .nav-link {
                color: #ddd !important;
                font-weight: 500;
                margin: 0 8px;
                transition: 0.25s;
                padding: 10px 15px !important;
                border-radius: 6px;
            }

                .navbar-admin .nav-link:hover {
                    background-color: #333;
                    color: #fff !important;
                    transform: translateY(-2px);
                }

            .navbar-admin .navbar-brand span {
                color: #f2f2f2;
                font-size: 1.1rem;
                letter-spacing: 1px;
            }

            .navbar-admin img:hover {
                transform: scale(1.1);
                transition: 0.3s;
            }

        .btn-danger {
            transition: 0.3s;
        }

            .btn-danger:hover {
                transform: scale(1.05);
            }
    </style>

    <!-- MAIN CONTENT -->
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer class="text-light text-center mb-3">
            <p>&copy; @DateTime.Now.Year - Trang quản trị HKTMOVIE</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")

    <!-- jQuery CDN nếu bạn muốn chắc chắn -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

    @Scripts.Render("~/bundles/bootstrap")

    @Scripts.Render("~/bundles/jqueryval")

    @RenderSection("scripts", required: false)


</body>
</html>
